<Window x:Class="LegionTelemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legion Telemetry" Width="410" Height="38"
        SizeToContent="Width" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Opacity="0.6" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border x:Name="OverlayPanel" Background="#E9111820" CornerRadius="7" Padding="12,8"
            BorderBrush="#55647584" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CpuDisplay" Text="CPU --% / --°C" Foreground="#76C9FF" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"/>
            <TextBlock Text=" | " Foreground="#8492A2" FontSize="12" FontFamily="Consolas"/>
            <TextBlock x:Name="GpuDisplay" Text="GPU --% / --°C" Foreground="#83DFAC" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"/>
            <TextBlock Text=" | " Foreground="#8492A2" FontSize="12" FontFamily="Consolas"/>
            <TextBlock x:Name="RamDisplay" Text="RAM -- GB" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"/>
        </StackPanel>
    </Border>
</Window>
